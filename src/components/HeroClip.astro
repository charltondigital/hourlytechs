---
const { name, alt } = Astro.props;
---
<div class="hero-clip">
  <img src={`/images/${name}.webp`} alt={alt} width="640" height="640" fetchpriority="high" />
  <video data-src={`/images/${name}.mp4`} muted loop playsinline preload="none" aria-hidden="true"></video>
  <button type="button" aria-label="Pause video" title="Pause video" hidden>
    <svg class="pause-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M9 5v14M15 5v14" /></svg>
    <svg class="play-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5l12 7-12 7z" /></svg>
  </button>
</div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const video of document.querySelectorAll<HTMLVideoElement>('.hero-clip video')) {
    const control = video.parentElement?.querySelector('button');
    if (!control) continue;

    let pausedByUser = false;
    control.addEventListener('click', () => {
      pausedByUser = !video.paused;
      if (pausedByUser) video.pause();
      else video.play().catch(() => {});
    });
    video.addEventListener('pause', () => {
      control.setAttribute('aria-label', 'Play video');
      control.title = 'Play video';
    });

    const syncMotion = () => {
      if (reducedMotion.matches) {
        control.hidden = true;
        video.pause();
        video.classList.remove('playing');
        return;
      }

      if (!video.src && video.dataset.src) {
        video.src = video.dataset.src;
      }

      if (!pausedByUser) video.play().catch(() => {});
    };

    video.addEventListener('playing', () => {
      if (reducedMotion.matches) return;
      video.classList.add('playing');
      control.setAttribute('aria-label', 'Pause video');
      control.title = 'Pause video';
      control.hidden = false;
    });
    reducedMotion.addEventListener('change', syncMotion);
    syncMotion();
  }
</script>

<style>
  .hero-clip {
    position: relative;
    height: clamp(300px, 35vw, 460px);
  }
  img, video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  video {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  video.playing {
    visibility: visible;
  }
  button {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 36px;
    height: 36px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.38);
    color: white;
    cursor: pointer;
    transition: background 150ms ease;
  }
  button[hidden] { display: none; }
  button:hover, button:focus-visible { background: rgba(0, 0, 0, 0.75); }
  button:focus-visible { outline: 2px solid white; outline-offset: 2px; }
  .play-icon, button[aria-label="Play video"] .pause-icon { display: none; }
  button[aria-label="Play video"] .play-icon { display: block;
  }
  @media (max-width: 600px) {
    .hero-clip { height: 260px; }
  }
</style>
