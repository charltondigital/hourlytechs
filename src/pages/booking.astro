---
import Base from '../layouts/Base.astro';
import { CalendarDays, Headset, UserRoundCheck } from 'lucide-astro';
---
<Base title="Booking technology support | HourlyTechs" description="Choose a scheduled appointment or request the next available specialist. Booking is not yet open."><section class="hero"><div class="wrap hero-grid"><div><h1>Choose when you need help</h1><p class="lead">Choose a scheduled appointment or request the next available specialist. Booking is not yet open.</p><div class="actions"><a class="button" href="/contact/">Request tech help</a></div></div><div class="hero-photo"><img src="/images/remote-support.png" alt="Illustrative remote support professional" width="1728" height="882"/></div></div></section><section class="block"><div class="wrap"><h2>Two ways to get support</h2><div class="service-grid"><article class="service"><span class="service-icon" aria-hidden="true"><CalendarDays size={32} strokeWidth={1.75} /></span><h3>Schedule an appointment</h3><p>Plan ahead for nonurgent repairs, setup and training. Scheduled rates start at $36 per hour.</p></article><article class="service"><span class="service-icon" aria-hidden="true"><Headset size={32} strokeWidth={1.75} /></span><h3>Request on-demand help</h3><p>For problems that cannot wait, request the next available specialist at the applicable on-demand rate, starting at $60 per hour.</p></article><article class="service"><span class="service-icon" aria-hidden="true"><UserRoundCheck size={32} strokeWidth={1.75} /></span><h3>Choose the right expertise</h3><p>Describe the issue first so that the appropriate specialty and rate can be agreed before work begins.</p></article></div></div></section><section class="block pricing"><div class="wrap"><h2>Before your session</h2><div class="service-grid"><article class="service"><h3>Gather the details</h3><p>Have your device type, software name and any error messages ready.</p></article><article class="service"><h3>Prepare for remote help</h3><p>Make sure you have a working connection if possible. Enter your own passwords and approve access only when needed.</p></article><article class="service"><h3>Confirm the terms</h3><p>Agree on the repair scope or project deliverable and applicable rate. Eligible unsuccessful repairs are not charged.</p></article></div><div class="actions"><a class="button" href="/#pricing">View service pricing</a><a class="plain" href="/#services">Explore services</a></div></div></section></Base>