---
import Base from '../layouts/Base.astro';
import { Headset, Clock, ShieldCheck } from 'lucide-astro';
---
<Base title="About HourlyTechs | HourlyTechs" description="Flagstaff-based hourly remote technology support for Arizona households and businesses."><section class="hero"><div class="wrap hero-grid"><div><h1>About HourlyTechs</h1><p class="lead">Flagstaff-based hourly remote technology support for Arizona households and businesses.</p></div><div class="hero-photo"><img src="/images/remote-support.png" alt="Remote support professional wearing a headset" width="1728" height="882"/></div></div></section><section class="block"><div class="wrap"><h2>How we provide support</h2><div class="service-grid"><article class="service"><span class="service-icon" aria-hidden="true"><Headset size={32} strokeWidth={1.75} /></span><h3>Remote technicians</h3><p>Access to people who can work through a technology problem with you, not just a list of automated suggestions.</p></article><article class="service"><span class="service-icon" aria-hidden="true"><Clock size={32} strokeWidth={1.75} /></span><h3>Per-minute billing</h3><p>Clear hourly rates billed by the minute, with a choice between planned and on-demand support.</p></article><article class="service"><span class="service-icon" aria-hidden="true"><ShieldCheck size={32} strokeWidth={1.75} /></span><h3>Repair guarantee</h3><p>Agree on the problem before starting. Our no fix, no fee policy covers eligible repairs.</p></article></div></div></section><section class="block pricing"><div class="wrap"><h2>Services for Arizona customers</h2><div class="service-grid"><article class="service"><h3>Households</h3><p>Everyday computer, email, printer and home connectivity help.</p></article><article class="service"><h3>Small businesses</h3><p>Support for office software, cloud applications, websites and more complex IT tasks.</p></article><article class="service"><h3>AI & automation</h3><p>Practical training and defined implementation projects for individuals and organizations.</p></article></div><div class="actions"><a class="button" href="/#pricing">View service pricing</a><a class="plain" href="/#services">Explore services</a></div></div></section></Base>