---
import '../styles/global.css';
const {title='HourlyTechs | Arizona remote technology support',description='Flagstaff-based technology help for Arizona homes and businesses, from everyday computer issues to AI and automation.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/></head><body><a class="skip" href="#main">Skip to content</a><header><div class="wrap nav"><a class="brand" href="/" aria-label="HourlyTechs home"><svg viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="8" fill="currentColor"/><path d="M11 10v20m18-20v20M11 20h18M23 13l6 7-6 7" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>hourly<span>techs</span></a><button class="menu" aria-expanded="false" aria-controls="navlinks">Menu ☰</button><nav id="navlinks" aria-label="Main navigation"><a href="/home-tech/">Home tech</a><a href="/business-tech/">Business tech</a><a href="/ai/">AI & automation</a><a href="/research/">Research</a><a class="nav-cta" href="/about/">About</a></nav></div></header><main id="main"><slot/></main><footer><div class="wrap foot"><div><a class="brand" href="/">hourly<span>techs</span></a><p>Based in Flagstaff, Arizona.</p></div><div class="footlinks"><a href="/about/">About</a><a href="/research/">Research</a><a href="/privacy/">Privacy</a></div><small>© {new Date().getFullYear()} HourlyTechs</small></div></footer><script>const b=document.querySelector('.menu');const n=document.querySelector('#navlinks');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n?.classList.toggle('open',!o);});document.addEventListener('keydown',e=>{if(e.key==='Escape'){b?.setAttribute('aria-expanded','false');n?.classList.remove('open');}});</script></body></html>