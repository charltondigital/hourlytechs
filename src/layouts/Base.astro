---
import '../styles/global.css';
const {title='HourlyTechs | Hourly remote tech support',description='Remote tech support for homes and businesses, from everyday computer issues to AI and automation.',noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title>{noindex && <meta name="robots" content="noindex"/>}<meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/></head><body><a class="skip" href="#main">Skip to content</a><header><div class="wrap nav"><a class="brand" href="/" aria-label="HourlyTechs home"><svg viewBox="0 0 60 60" aria-hidden="true"><g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" fill="none"><circle cx="30" cy="34" r="21" stroke-width="6"/><path d="M30 13V6 M24 5H36" stroke-width="5"/><path d="M30 19V22 M15 34H18 M42 34H45 M30 46V49" stroke-width="3"/><path d="M30 34L39 24" stroke-width="5"/><circle cx="30" cy="34" r="2.5" fill="currentColor" stroke="none"/></g></svg><span class="brand-name"><span class="brand-hourly">hourly</span>techs</span></a><button class="menu" aria-expanded="false" aria-controls="navlinks">Menu ☰</button><nav id="navlinks" aria-label="Main navigation"><a href="/home-tech/">Personal</a><a href="/business-tech/">Business</a><a href="/ai/">AI & automation</a><a href="/research/">Research</a><a href="/about/">About</a><a class="nav-cta" href="/contact/">Get help</a></nav></div></header><main id="main"><slot/></main><footer><div class="wrap foot"><div><a class="brand" href="/"><span class="brand-name"><span class="brand-hourly">hourly</span>techs</span></a><p>Based in Flagstaff, Arizona.</p></div><div class="footlinks"><a href="/about/">About</a><a href="/research/">Research</a><a href="/privacy/">Privacy</a><a href="/contact/?type=general">Contact</a></div><small>© {new Date().getFullYear()} HourlyTechs</small></div></footer><script>const b=document.querySelector('.menu');const n=document.querySelector('#navlinks');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n?.classList.toggle('open',!o);});document.addEventListener('keydown',e=>{if(e.key==='Escape'){b?.setAttribute('aria-expanded','false');n?.classList.remove('open');}});</script></body></html>